# ─────────────────────────────────────────────────────────────────
#  Industrial Fire Detection System — API Credentials
#  Copy this file to .env and fill in your actual keys.
# ─────────────────────────────────────────────────────────────────

# NASA FIRMS MAP_KEY (free at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=your_firms_map_key_here

# Copernicus Data Space Ecosystem (CDSE) — for Sentinel-2 optical verification
# Register free at https://dataspace.copernicus.eu/
CDSE_USERNAME=your_cdse_username_here
CDSE_PASSWORD=your_cdse_password_here

# Set to "true" to use synthetic mock data instead of live API calls (for development)
USE_MOCK_DATA=true
